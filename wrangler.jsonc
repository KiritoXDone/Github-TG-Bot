{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "github-tg-bot",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "github-tg-bot",
      "database_id": "2bdd4d8f-c5b0-4cc7-8f23-3dca3973ffac",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": { "crons": ["* * * * *"] }
}
